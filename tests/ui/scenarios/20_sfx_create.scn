# Самораспаковывающийся архив: галочка в окне создания (Alt+A на диске).
#copydir {DATA}\src | {WORK}\sfx\src
size 100 30
run "{CABINE}" "{WORK}\sfx"
waitfor 5000 src
key Down
key Alt+A
waitfor 3000 Обзор
key Enter
waitfor 3000 Новый архив
waitfor 3000 Будет создан:
waitfor 3000 src.cab
key Alt+N
key Tab
key Space
waitfor 3000 src.exe
dump 20_add_dlg
key Enter
waitfor 8000 src.exe
key Alt+X
exit 3000
#expect-file {WORK}\sfx\src.exe
