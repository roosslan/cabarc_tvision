# 7z с паролем: зашифрованные заголовки — пароль при открытии, после неверного
# спрашивается снова; распаковка без повторного запроса (пароль запомнен).
#copy {TESTDATA}\secrethdr.7z | {WORK}\7zp\secrethdr.7z
#remove {WORK}\7zp\out
size 100 30
run "{CABINE}" "{WORK}\7zp\secrethdr.7z"
waitfor 5000 Пароль
type неверный
key Enter
waitfor 5000 Неверный пароль
type Пароль1
key Enter
waitfor 5000 Документ.txt
waitfor 3000 7z, пароль
waitfor 3000 readme.txt *
key Alt+E
waitfor 3000 Извлечь файлы
type {WORK}\7zp\out
key Enter
wait 2000
key Alt+X
exit 3000
#expect-same {DATA}\src | {WORK}\7zp\out
